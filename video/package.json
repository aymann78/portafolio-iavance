{
  "name": "shorts-seguridad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "voice": "node scripts/voice.mjs",
    "sfx": "node scripts/sfx.mjs",
    "render": "remotion render src/index.ts Short01 out/short01_raw.mp4 --gl=angle --concurrency=4 --timeout=180000 --crf=16 --audio-bitrate=320k",
    "master": "ffmpeg -y -i out/short01_raw.mp4 -c:v copy -af loudnorm=I=-14:TP=-1.5:LRA=11 -c:a aac -b:a 320k out/short01.mp4",
    "still": "remotion still src/index.ts Short01 out/frame.png --gl=angle --frame=90"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "@remotion/cli": "4.0.250",
    "@remotion/media-utils": "^4.0.250",
    "@remotion/three": "4.0.250",
    "@remotion/transitions": "^4.0.250",
    "postprocessing": "^6.36.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.250",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/three": "^0.169.0",
    "typescript": "^5.4.5"
  }
}